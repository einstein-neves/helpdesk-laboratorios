# Modelo de configuração. Copie para backend/.env e preencha os valores.
# O arquivo .env real nunca deve ser enviado ao Git.

PORT=3000

# --- Modo demo local (sem Supabase nem PostgreSQL) ---
# Só inicia com NODE_ENV=development; os dados ficam em memória.
NODE_ENV=development
DEMO_MODE=true
DEMO_EMAIL=desenvolvedor@localhost.test
DEMO_PASSWORD=defina-uma-senha-local

# --- Modo integrado (defina DEMO_MODE=false e preencha abaixo) ---
# SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres
# DB_SSL=true
# DB_SSL_CA_PATH=certs/supabase-ca.crt
# CORS_ORIGINS=
